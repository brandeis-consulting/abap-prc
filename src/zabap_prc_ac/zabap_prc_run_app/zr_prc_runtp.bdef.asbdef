managed implementation in class zbp_prc_run unique;
strict ( 2 );
extensible;

with privileged mode disabling NoCheckWhenPrivileged;

define authorization context NoCheckWhenPrivileged {
  'ZPRC_RUN';
}

define behavior for ZR_PRC_RunTP alias Run
extensible
persistent table zprc_run ##UNMAPPED_FIELD[SEVERITYCODESUCCESS] ##UNMAPPED_FIELD[SEVERITYCODEERROR] ##UNMAPPED_FIELD[MESSAGESEVERITY]
                          ##UNMAPPED_FIELD[NUMBEROFERRORS] ##UNMAPPED_FIELD[NUMBEROFSUCCESS] ##UNMAPPED_FIELD[CURRENTLYPROCESSEDNUMBER]
with additional save
lock master
authorization master ( instance )
{
  // Everybody may call create and initiateRun; the precheck checks the application name
  create ( precheck, authorization : none );
  update;
  delete;
  field ( readonly, numbering : managed ) UUID;
  field ( mandatory : create, readonly : update ) ApplicationName;
  // Derived from the processed objects of the run (ZR_PRC_RunProgress), not persisted
  field ( readonly ) NumberOfErrors, NumberOfSuccess, CurrentlyProcessedNumber;

  static factory action ( precheck, authorization : none ) initiateRun parameter ZA_PRC_InitiateRunParameter [1];
  action triggerChangedEvent;

  association _Parameter { create; }

  mapping for zprc_run
  corresponding extensible
    {
      UUID                     = uuid;
      ApplicationName          = app_name;
      JobName                  = job_name;
      JobID                    = job_id;
      JobCount                 = job_count;
      JobStart                 = job_start;
      JobEnd                   = job_end;
      ExecutionStatus          = execution_status;
      TotalNumber              = total_number;
      CreatedBy                = created_by;
      // Reason of an aborted run (Nr. 40.6), written by the run job
      MessageClass             = msgid;
      MessageNumber            = msgno;
      MessageVariable1         = msgv1;
      MessageVariable2         = msgv2;
      MessageVariable3         = msgv3;
      MessageVariable4         = msgv4;
      MessageText              = message_text;
    }
}

define behavior for ZR_PRC_RunParameterTP alias RunParameter
persistent table zprc_run_params
lock dependent by _Run
authorization dependent by _Run
{
  internal delete;
  field ( readonly, numbering : managed ) UUID;
  field ( readonly ) JobUUID;
  association _Run;
  mapping for zprc_run_params
    {
      UUID          = uuid;
      JobUUID       = job_uuid;
      ParameterName = parameter_name;
      Operator      = operator;
      Sign          = sign;
      Low           = low;
      High          = high;
    }
}