managed implementation in class zbp_prc_message unique;
strict ( 2 );
extensible;

// Read-only grouping of the current header messages; the only operation is
// resuming all objects of a message, delegated to the processed object BO
define behavior for ZR_PRC_MessageTP alias Message
extensible
lock master
authorization master ( instance )
with unmanaged save
{
  field ( readonly ) ProcessName, MessageClass, MessageNumber, MessageSeverity, MessageVariable1, MessageVariable2, MessageVariable3, MessageVariable4, MessageText;
  action ( features : instance ) resumeProcessing result [1] $self;
  // Changes nothing: raises the changed event for side effects (extension
  // ZR_PRC_MESSAGEEXT, 2025 and BTP) - called by the engine after each step
  action ( authorization : none, lock : none ) triggerChangedEvent;

  association _ObjectsForMessage { }
}

define behavior for ZR_PRC_ObjectForMessageTP alias Objects
lock dependent by _Message
authorization dependent by _Message
with unmanaged save
{
  field ( readonly, numbering : managed ) StepUUID;
  field ( readonly ) ProcessName, MessageNumber, MessageClass, MessageSeverity, MessageVariable1, MessageVariable2, MessageVariable3, MessageVariable4, MessageText;

  association _Message;
}