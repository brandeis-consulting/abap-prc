managed implementation in class zbp_r_prc_test_bgpf unique;
strict ( 2 );

define behavior for ZR_PRC_Test_Bgpf alias TestBgpf
persistent table zprc_test_bgpf
late numbering
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( readonly ) ID, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  mapping for zprc_test_bgpf corresponding
