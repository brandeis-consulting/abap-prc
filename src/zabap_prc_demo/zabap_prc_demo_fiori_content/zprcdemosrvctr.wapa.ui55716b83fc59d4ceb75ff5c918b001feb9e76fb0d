/* eslint-disable linebreak-style */                                                                                                                                                                                                                           
sap.ui.define([                                                                                                                                                                                                                                                
    "sap/base/Log",                                                                                                                                                                                                                                            
    "sap/m/MessageToast"                                                                                                                                                                                                                                       
], (Log, MessageToast) => {                                                                                                                                                                                                                                    
    "use strict";                                                                                                                                                                                                                                              
&nbsp;                                                                                                                                                                                                                                                         
    const ACTION_NAME =&nbsp;&nbsp;                                                                                                                                                                                                                            
    "com.sap.gateway.srvd.zui_prc_demo_srvctr_o4.v0001.adjustViaSelectOptions" +                                                                                                                                                                               
        "(Collection(com.sap.gateway.srvd.zui_prc_demo_srvctr_o4.v0001.ServiceContractType))";                                                                                                                                                                 
&nbsp;                                                                                                                                                                                                                                                         
    async function ensureBindingAndHeaderContext(oListBinding) {                                                                                                                                                                                               
        // Binding mit den aktuellen Filtern initialisieren                                                                                                                                                                                                    
        await oListBinding.requestContexts(0, 1);                                                                                                                                                                                                              
&nbsp;                                                                                                                                                                                                                                                         
        const oHeaderContext = oListBinding.getHeaderContext();                                                                                                                                                                                                
        if (!oHeaderContext) {                                                                                                                                                                                                                                 
            throw new Error("HeaderContext nicht verfügbar.");                                                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
        return oHeaderContext;                                                                                                                                                                                                                                 
    }                                                                                                                                                                                                                                                          
&nbsp;                                                                                                                                                                                                                                                         
    function getFilterAsJson() {                                                                                                                                                                                                                               
        // Try to access the internal filter bar                                                                                                                                                                                                               
        var oFilterBar;                                                                                                                                                                                                                                        
        try {                                                                                                                                                                                                                                                  
            // Get the filter bar from the page                                                                                                                                                                                                                
            var oView = sap.ui.getCore().byId("abap.demo.processingcenter.demosrvctr::ServiceContractList");                                                                                                                                                   
            if (oView) {                                                                                                                                                                                                                                       
                // Find the filter bar control                                                                                                                                                                                                                 
                // Stefan Engelhardt; Verbesserung: FilterBar abholen via ID                                                                                                                                                                                   
                var aFilterBars = [];                                                                                                                                                                                                                          
                oView.findAggregatedObjects(true, function (oControl) {                                                                                                                                                                                        
                    if (oControl.isA("sap.ui.mdc.FilterBar")) {                                                                                                                                                                                                
                        aFilterBars.push(oControl);                                                                                                                                                                                                            
                        return true;                                                                                                                                                                                                                           
                    }                                                                                                                                                                                                                                          
                    return false;                                                                                                                                                                                                                              
                });                                                                                                                                                                                                                                            
&nbsp;                                                                                                                                                                                                                                                         
                if (aFilterBars.length > 0) {                                                                                                                                                                                                                  
                    oFilterBar = aFilterBars[0];                                                                                                                                                                                                               
                }                                                                                                                                                                                                                                              
            } else {                                                                                                                                                                                                                                           
                Log.error("view not found")                                                                                                                                                                                                                    
            }                                                                                                                                                                                                                                                  
        } catch (e) {                                                                                                                                                                                                                                          
            console.error("Error finding filter bar:", e);                                                                                                                                                                                                     
        }                                                                                                                                                                                                                                                      
&nbsp;                                                                                                                                                                                                                                                         
        var oFilterData = [];                                                                                                                                                                                                                                  
&nbsp;                                                                                                                                                                                                                                                         
        if (oFilterBar) {                                                                                                                                                                                                                                      
            try {                                                                                                                                                                                                                                              
                // Get filter conditions from MDC FilterBar                                                                                                                                                                                                    
                // Stefan Engelhardt: getSelectionVariant                                                                                                                                                                                                      
                // UI Header Info im CDS definieren                                                                                                                                                                                                            
                var oConditions = oFilterBar.getConditions();                                                                                                                                                                                                  
                var nameIndex = -1;                                                                                                                                                                                                                            
&nbsp;                                                                                                                                                                                                                                                         
                // Convert conditions to a simpler format                                                                                                                                                                                                      
                for (var sKey in oConditions) {                                                                                                                                                                                                                
                    if (oConditions.hasOwnProperty(sKey) && oConditions[sKey] && oConditions[sKey].length > 0) {                                                                                                                                               
                        var jsonArrayIndex = -1;                                                                                                                                                                                                               
                        var T_VALUE = [];                                                                                                                                                                                                                      
                        for (var conditionIndex in oConditions[sKey]) {                                                                                                                                                                                        
                            var low = '';                                                                                                                                                                                                                      
                            var high = '';                                                                                                                                                                                                                     
                            if (oConditions[sKey][conditionIndex].values.length > 0) {                                                                                                                                                                         
                                low = oConditions[sKey][conditionIndex].values[0];                                                                                                                                                                             
                            }                                                                                                                                                                                                                                  
                            if (oConditions[sKey][conditionIndex].values.length > 1) {                                                                                                                                                                         
                                high = oConditions[sKey][conditionIndex].values[1];                                                                                                                                                                            
                            }                                                                                                                                                                                                                                  
                            T_VALUE[++jsonArrayIndex] = {                                                                                                                                                                                                      
                                KIND : '',                                                                                                                                                                                                                     
                                SIGN: 'I',                                                                                                                                                                                                                     
                                OPTION: oConditions[sKey][conditionIndex].operator,                                                                                                                                                                            
                                LOW: low,                                                                                                                                                                                                                      
                                HIGH: high                                                                                                                                                                                                                     
                            };                                                                                                                                                                                                                                 
                        }                                                                                                                                                                                                                                      
                        oFilterData[++nameIndex] = {                                                                                                                                                                                                           
                            NAME : sKey,                                                                                                                                                                                                                       
                            T_VALUE : T_VALUE                                                                                                                                                                                                                  
                        }                                                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                }                                                                                                                                                                                                                                              
            } catch (e) {                                                                                                                                                                                                                                      
                Log.error("Error reading filter conditions:", e);                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
&nbsp;                                                                                                                                                                                                                                                         
        // Serialize the filter data as JSON                                                                                                                                                                                                                   
        var sFilterDataJson = JSON.stringify(oFilterData, null, 2);                                                                                                                                                                                            
        Log.error(sFilterDataJson);                                                                                                                                                                                                                            
        return sFilterDataJson;                                                                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
&nbsp;                                                                                                                                                                                                                                                         
    return {                                                                                                                                                                                                                                                   
        adjustViaSelectOptions: async function (oEvent) {&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                          
            const oEditFlow = this.getEditFlow();                                                                                                                                                                                                              
            const oView = this.getRouting().getView();                                                                                                                                                                                                         
            const oTable = oView.byId("abap.demo.processingcenter.demosrvctr::ServiceContractList--fe::table::ServiceContract::LineItem");                                                                                                                     
            const oListBinding = oTable?.getRowBinding();                                                                                                                                                                                                      
&nbsp;                                                                                                                                                                                                                                                         
            if (!oListBinding) {                                                                                                                                                                                                                               
                Log.error("ListBinding nicht gefunden!");                                                                                                                                                                                                      
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
&nbsp;                                                                                                                                                                                                                                                         
            try {                                                                                                                                                                                                                                              
                // Binding initialisieren – NUR wenn noch nicht geladen                                                                                                                                                                                        
                const oHeaderContext = await ensureBindingAndHeaderContext(oListBinding);                                                                                                                                                                      
&nbsp;                                                                                                                                                                                                                                                         
                // Filter-String: erst URL versuchen, dann leer lassen                                                                                                                                                                                         
                // (URL-Methode funktioniert nur nach "Go")                                                                                                                                                                                                    
                const sFilterString = getFilterAsJson();//await getFilterStringFromUrl(oListBinding);                                                                                                                                                          
&nbsp;                                                                                                                                                                                                                                                         
                await oEditFlow.invokeAction(ACTION_NAME, {                                                                                                                                                                                                    
                    contexts: oHeaderContext,                                                                                                                                                                                                                  
                    label: '{i18n>adjustViaSelectOptionsActionText}',                                                                                                                                                                                          
                    parameterValues: [                                                                                                                                                                                                                         
                        { name: "selectOptions", value: sFilterString }                                                                                                                                                                                        
                    ],                                                                                                                                                                                                                                         
                    skipParameterDialog: false                                                                                                                                                                                                                 
                }).then(( response ) => {                                                                                                                                                                                                                      
                    debugger;                                                                                                                                                                                                                                  
                    var sResponse = response.getObject().runUUID;                                                                                                                                                                                              
                    Log.error('Response: ' + sResponse);                                                                                                                                                                                                       
&nbsp;                                                                                                                                                                                                                                                         
                    sap.ushell.Container.getServiceAsync("CrossApplicationNavigation").then(function (oCrossAppNav) {                                                                                                                                          
                            oCrossAppNav.toExternal({                                                                                                                                                                                                          
                                target: {                                                                                                                                                                                                                      
                                    semanticObject: "ABAP_PRC_Run",                                                                                                                                                                                            
                                    action: "show"                                                                                                                                                                                                             
                                },                                                                                                                                                                                                                             
                                params: {                                                                                                                                                                                                                      
                                    UUID: sResponse&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                    
                                }                                                                                                                                                                                                                              
                            });                                                                                                                                                                                                                                
                    });                                                                                                                                                                                                                                        
                });                                                                                                                                                                                                                                            
            } catch (oError) {                                                                                                                                                                                                                                 
                const sMsg = oError instanceof Error                                                                                                                                                                                                           
                    ? oError.message                                                                                                                                                                                                                           
                    : JSON.stringify(oError);                                                                                                                                                                                                                  
                Log.error(`Fehler bei Action: ${sMsg}`, oError);                                                                                                                                                                                               
                MessageToast.show(`Fehler: ${sMsg}`);                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            